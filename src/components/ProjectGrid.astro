---
import ProjectIcon from './ProjectIcon.astro';
import { getProjects, slugOf } from '../lib/content';
import { ui, localePath, type Lang } from '../i18n';
import { nbh, site } from '../site';

interface Props {
  lang: Lang;
  /** Отступ сверху поменьше - когда над сеткой уже есть заголовок страницы. */
  tight?: boolean;
}

const { lang, tight = false } = Astro.props;
const t = ui[lang];
const projects = await getProjects(lang);
const types = ['app', 'web', 'web3', 'game', 'level'] as const;
const filters = ['all', ...types] as const;
// вкладки без готовых проектов показывают строку «Здесь будут новые …»
const released = new Set(projects.map((p) => p.data.type));
const emptyTypes = types.filter((type) => !released.has(type));
---

<section class:list={['projects', { tight }]} aria-label={t.projects.title}>
  <div class="filter t-small" role="group" aria-label={t.filterLabel} data-filter="project-list">
    {
      filters.map((key, i) => (
        <button type="button" data-key={key} aria-pressed={i === 0 ? 'true' : 'false'}>
          {t.filters[key]}
        </button>
      ))
    }
  </div>
  <ul class="grid" id="project-list">
    {
      projects.map((p) => (
        <li data-tag={p.data.type}>
          <a
            href={localePath(lang, `/projects/${slugOf(p)}/`)}
            class="cell has-tip"
            aria-label={`${p.data.title} | ${t.projectTypes[p.data.type]}`}
          >
            <ProjectIcon icon={p.data.icon} />
            <span class="tip below" role="tooltip">
              <span class="t-label muted">{t.projectTypes[p.data.type]}</span>
              <span class="t-name">{p.data.title}</span>
              <span class="t-small">{nbh(p.data.summary)}</span>
              <span class="t-small muted">{t.details}</span>
            </span>
          </a>
        </li>
      ))
    }
    {
      site.upcoming.map((type) => (
        <li data-tag={type}>
          <span class="cell soon has-tip" tabindex="0" aria-label={`${t.soon.name} | ${t.soon.type}`}>
            <ProjectIcon icon="lock" soon />
            <span class="tip below" role="tooltip">
              <span class="t-label muted">{t.soon.type}</span>
              <span class="t-name">{t.soon.name}</span>
              <span class="t-small">{t.soon.text}</span>
            </span>
          </span>
        </li>
      ))
    }
  </ul>
  {
    emptyTypes.map((type) => (
      <p class="info t-body muted" data-info-for="project-list" data-info={type} hidden>
        {nbh(t.emptyType[type])}
      </p>
    ))
  }
</section>

<script>
  import '../scripts/filter';
</script>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
    padding: 120px 24px 0;
  }

  .projects.tight {
    padding-top: 72px;
  }

  .filter {
    justify-content: center;
  }

  .grid {
    --size: 64px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 48px;
    max-width: calc(5 * 64px + 4 * 48px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cell {
    display: block;
  }

  .cell:hover {
    opacity: 1;
  }

  .cell.soon {
    cursor: default;
  }

  .info {
    margin-top: -24px;
    text-align: center;
  }

  /* При наведении плитка вместе с рисунком чуть уменьшается. */
  .cell :global(.tile) {
    transition: transform 0.2s ease, background-color 0.25s ease, color 0.25s ease;
  }

  @media (hover: hover) {
    .cell:hover :global(.tile),
    .cell:focus-visible :global(.tile) {
      transform: scale(0.92);
    }
  }

  @media (max-width: 640px) {
    .projects {
      gap: 36px;
      padding-top: 72px;
    }

    .projects.tight {
      padding-top: 40px;
    }

    /* пять плиток в ряд помещаются даже на телефонах шириной 360px */
    .grid {
      --size: 48px;
      gap: 16px;
      max-width: calc(5 * 48px + 4 * 16px);
    }
  }
</style>

---
import { ui, localePath, alternatePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  active?: 'projects' | 'blog' | 'about';
  alternates?: boolean;
}

const { lang, active, alternates = true } = Astro.props;
const t = ui[lang];
const links = [
  { key: 'projects', href: '/projects/' },
  { key: 'blog', href: '/blog/' },
  { key: 'about', href: '/about/' },
] as const;
const other: Lang = lang === 'ru' ? 'en' : 'ru';
const otherHref = alternates ? alternatePath(Astro.url.pathname, lang) : localePath(other, '/');
---

<header class="header" data-header>
  <a href={localePath(lang, '/')} class="t-name">{t.name}</a>
  <nav class="nav t-small" id="site-nav" aria-label={t.navLabel}>
    {
      links.map((link) => (
        <a
          href={localePath(lang, link.href)}
          class:list={{ muted: active && active !== link.key }}
          aria-current={active === link.key ? 'page' : undefined}
        >
          {t.nav[link.key]}
        </a>
      ))
    }
    <span class="lang" aria-label={t.langLabel}>
      {
        lang === 'ru' ? (
          <>
            <span aria-current="true">RU</span>
            <a href={otherHref} class="muted" hreflang="en" lang="en">EN</a>
          </>
        ) : (
          <>
            <a href={otherHref} class="muted" hreflang="ru" lang="ru">RU</a>
            <span aria-current="true">EN</span>
          </>
        )
      }
    </span>
  </nav>
  <div class="actions">
    <button class="t-name" type="button" data-theme-toggle aria-label={t.theme}>◐</button>
    <button class="menu t-small" type="button" data-menu aria-expanded="false" aria-controls="site-nav">
      {t.menu}
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  const header = document.querySelector('[data-header]');
  const menu = document.querySelector('[data-menu]');
  menu?.addEventListener('click', () => {
    const open = header?.classList.toggle('open') ?? false;
    menu.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 32px var(--pad);
  }

  .header > a {
    margin-right: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .lang {
    display: inline-flex;
    gap: 0.35em;
    white-space: nowrap;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .menu {
    display: none;
  }

  @media (max-width: 640px) {
    .header {
      flex-wrap: wrap;
      gap: 20px;
      padding: 20px var(--pad);
    }

    .actions {
      order: 2;
    }

    .menu {
      display: inline;
    }

    .nav {
      display: none;
      order: 3;
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding: 16px 0 8px;
      font-size: 19px;
      line-height: 28px;
    }

    .header.open .nav {
      display: flex;
    }
  }
</style>

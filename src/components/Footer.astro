---
import { site } from '../site';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<footer class="footer t-small">
  <nav aria-label={t.contactsLabel}>
    {
      site.contacts.map((contact) => (
        <a
          href={contact.href}
          class="contact has-tip"
          {...(contact.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
        >
          <span class="label">{t.contacts[contact.key]}</span>
          <span class="tip above" role="tooltip">
            <span class="t-label muted">{t.contactTips[contact.key].type}</span>
            <span class="t-name">{contact.handle}</span>
            <span class="t-small">{t.contactTips[contact.key].text}</span>
            <span class="t-small muted">{t.contactTips[contact.key].action}</span>
          </span>
        </a>
      ))
    }
  </nav>
  <p class="muted">© {new Date().getFullYear()}</p>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 200px 24px 72px;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  .contact {
    display: inline-block;
  }

  /* Ссылка целиком не тускнеет, иначе потускнела бы и карточка - гаснет только подпись. */
  .contact:hover {
    opacity: 1;
  }

  .contact:hover .label {
    opacity: 0.6;
  }

  @media (max-width: 640px) {
    .footer {
      gap: 12px;
      padding: 96px 24px 48px;
    }

    nav {
      gap: 24px;
    }
  }
</style>

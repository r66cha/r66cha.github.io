---
interface Props {
  alt: string;
  width: number;
  height: number;
  mobileWidth?: number;
  mobileHeight?: number;
}

const { alt, width, height, mobileWidth = width, mobileHeight = height } = Astro.props;
---

<!-- Пиксельная аватарка поверх ч/б фото: при наведении (или тапе на телефоне) пиксели растворяются и видно фото. -->
<span
  class="portrait"
  data-portrait
  style={`--w: ${width}px; --h: ${height}px; --mw: ${mobileWidth}px; --mh: ${mobileHeight}px`}
>
  <img class="photo" src="/images/portrait-dark.webp" alt={alt} width={width} height={height} />
  <img class="pixel" src="/images/portrait-pixel.png" alt="" aria-hidden="true" width={width} height={height} />
</span>

<script>
  // На тач-устройствах наведения нет — фото показывается по тапу.
  document.querySelectorAll<HTMLElement>('[data-portrait]').forEach((portrait) => {
    portrait.addEventListener('click', () => {
      if (matchMedia('(hover: none)').matches) portrait.classList.toggle('revealed');
    });
  });
</script>

<style>
  .portrait {
    position: relative;
    display: block;
    flex: none;
    width: var(--w);
    height: var(--h);
    overflow: hidden;
    background: #0a0a0a;
  }

  img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pixel {
    image-rendering: pixelated;
    transition: opacity 0.25s ease;
  }

  .portrait.revealed .pixel {
    opacity: 0;
  }

  @media (hover: hover) {
    .portrait:hover .pixel {
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .portrait {
      width: var(--mw);
      height: var(--mh);
    }
  }
</style>

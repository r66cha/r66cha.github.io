---
interface Props {
  alt: string;
  width: number;
  height: number;
  mobileWidth?: number;
  mobileHeight?: number;
}

const { alt, width, height, mobileWidth = width, mobileHeight = height } = Astro.props;
---

<!-- Ч/б портрет на чёрном фоне - один и тот же в обеих темах. -->
<span class="portrait" style={`--w: ${width}px; --h: ${height}px; --mw: ${mobileWidth}px; --mh: ${mobileHeight}px`}>
  <img src="/images/portrait-dark.webp" alt={alt} width={width} height={height} />
</span>

<style>
  .portrait {
    display: block;
    flex: none;
    width: var(--w);
    height: var(--h);
    overflow: hidden;
    background: #0a0a0a;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .portrait {
      width: var(--mw);
      height: var(--mh);
    }
  }
</style>

---
import { icons, type IconKey } from '../data/icons';

interface Props {
  icon: IconKey;
  /** Размер плитки в px; без него берётся --size из родителя (по умолчанию 64). */
  size?: number;
  /** Плитка будущего проекта: серая подложка и приглушённый рисунок. */
  soon?: boolean;
  class?: string;
}

const { icon, size, soon = false, class: className } = Astro.props;
---

<span class:list={['tile', { soon }, className]} style={size ? `--size: ${size}px` : undefined} aria-hidden="true">
  <svg viewBox="0 0 40 40" width="62.5%" height="62.5%" set:html={icons[icon]} />
</span>

<style>
  .tile {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--size, 64px);
    height: var(--size, 64px);
    background: var(--fg);
    color: var(--bg);
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .tile.soon {
    background: var(--surface);
    color: var(--muted);
  }
</style>

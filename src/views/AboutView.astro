---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import { site, nbh } from '../site';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<Base lang={lang} title={t.about.title} active="about">
  <section class="column">
    <Portrait alt={t.name} width={240} height={300} mobileWidth={200} mobileHeight={250} />

    <h1 class="t-title">{t.name}</h1>
    <p class="t-lead lead">
      {site.role}.
      <span class="muted">{nbh(t.about.lead)}</span>
    </p>

    <div class="t-text body">
      {t.about.paragraphs.map((p) => <p>{nbh(p)}</p>)}
    </div>

    <dl class="facts t-body">
      {
        t.about.facts.map(([key, value]) => (
          <>
            <dt>{key}</dt>
            <dd>{nbh(value)}</dd>
          </>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  .column {
    padding-top: 112px;
  }

  h1 {
    margin-top: 56px;
  }

  .lead {
    margin-top: 20px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 40px;
  }

  .facts {
    margin-top: 56px;
  }

  @media (max-width: 640px) {
    .column {
      padding-top: 48px;
    }

    h1 {
      margin-top: 36px;
    }

    .lead {
      margin-top: 12px;
    }

    .body {
      gap: 16px;
      margin-top: 28px;
    }

    .facts {
      margin-top: 40px;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import { getPosts, slugOf } from '../lib/content';
import { ui, localePath, formatDate, type Lang } from '../i18n';
import { nbh } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const posts = await getPosts(lang);
const filters = [['all', t.filters.all], ...Object.entries(t.blog.topics)];
---

<Base lang={lang} title={t.blog.title} active="blog">
  <section class="column">
    <h1 class="t-title">{t.blog.title}</h1>
    <p class="t-lead muted intro">{t.blog.intro}</p>

    <div class="filter t-small" role="group" aria-label={t.blog.topicLabel} data-filter="post-list">
      {
        filters.map(([key, label], i) => (
          <button type="button" data-key={key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {label}
          </button>
        ))
      }
    </div>

    <ul class="posts" id="post-list">
      {
        posts.map((post) => (
          <li data-tag={post.data.topic}>
            <a href={localePath(lang, `/blog/${slugOf(post)}/`)}>
              <span class="t-lead">{nbh(post.data.title)}</span>
              <span class="t-small muted">
                {formatDate(post.data.date, lang)} · {post.data.readTime} {t.blog.minutes}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  import '../scripts/filter';
</script>

<style>
  .column {
    padding-top: 112px;
  }

  .intro {
    margin-top: 12px;
  }

  .filter {
    margin-top: 48px;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .posts a {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @media (max-width: 640px) {
    .column {
      padding-top: 56px;
    }

    .intro {
      margin-top: 10px;
    }

    .filter {
      margin-top: 32px;
    }

    .posts {
      gap: 28px;
      margin-top: 40px;
    }

    .posts a {
      gap: 4px;
    }
  }
</style>

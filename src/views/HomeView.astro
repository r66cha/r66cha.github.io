---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { site, nbh } from '../site';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<Base lang={lang}>
  <section class="intro">
    <Portrait alt={t.name} width={128} height={160} mobileWidth={112} mobileHeight={140} />
    <p class="t-lead bio">
      <span class="first">{nbh(`${t.name} | ${site.role}.`)}</span>
      <span class="muted">{nbh(t.bio)}</span>
    </p>
  </section>
  <ProjectGrid lang={lang} />
</Base>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
    padding: 112px 24px 0;
    text-align: center;
  }

  .bio {
    max-width: 640px;
  }

  .first {
    display: block;
  }

  @media (max-width: 640px) {
    .intro {
      gap: 28px;
      padding-top: 56px;
    }
  }
</style>

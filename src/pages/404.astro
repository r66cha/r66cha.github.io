---
import Base from '../layouts/Base.astro';
---

<Base lang="ru" title="Страница не найдена" alternates={false}>
  <section class="column">
    <h1 class="t-title">Страница не найдена</h1>
    <p class="t-lead muted" lang="en">Page not found</p>
    <p class="links t-small">
      <a href="/">← На главную</a>
      <a href="/en/" lang="en">← Home</a>
    </p>
  </section>
</Base>

<style>
  .column {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding-top: 160px;
    text-align: center;
  }

  .links {
    display: flex;
    gap: 28px;
    margin-top: 20px;
  }
</style>

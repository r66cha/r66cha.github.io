---
import Base from '../layouts/Base.astro';
---

<Base title="Страница не найдена">
  <section class="column">
    <h1 class="t-title">Страница не найдена</h1>
    <p class="t-lead muted">Такой страницы нет или она переехала.</p>
    <a href="/" class="t-small">← На главную</a>
  </section>
</Base>

<style>
  .column {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding-top: 160px;
    text-align: center;
  }
</style>

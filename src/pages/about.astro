---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import { site, nbh } from '../site';

const facts = [
  ['Роль', 'Technical Product Owner'],
  ['Продукт', 'Управление и создание продуктов'],
  ['Код', 'Python, Solidity, Swift, TypeScript'],
  ['Игры', 'Level-дизайн, Game-дизайн'],
];
---

<Base title="Обо мне" active="about">
  <section class="column">
    <Portrait width={240} height={300} mobileWidth={200} mobileHeight={250} />

    <h1 class="t-title">{site.name}</h1>
    <p class="t-lead lead">
      {site.role}.
      <span class="muted">Создаю и развиваю продукты, пишу код и проектирую игры и уровни.</span>
    </p>

    <div class="t-text body">
      <p>
        Как Technical Product Owner веду продукт от идеи до релиза: формулирую, что и зачем строим, и сам разбираюсь в том,
        как это устроено технически.
      </p>
      <p>{nbh('Пишу на Python, Solidity, Swift и TypeScript. Помимо продуктов занимаюсь Level- и Game-дизайном: придумываю игры и уровни к ним.')}</p>
    </div>

    <dl class="facts t-body">
      {
        facts.map(([key, value]) => (
          <>
            <dt>{key}</dt>
            <dd>{nbh(value)}</dd>
          </>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  .column {
    padding-top: 112px;
  }

  h1 {
    margin-top: 56px;
  }

  .lead {
    margin-top: 20px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 40px;
  }

  .facts {
    margin-top: 56px;
  }

  @media (max-width: 640px) {
    .column {
      padding-top: 48px;
    }

    h1 {
      margin-top: 36px;
    }

    .lead {
      margin-top: 12px;
    }

    .body {
      gap: 16px;
      margin-top: 28px;
    }

    .facts {
      margin-top: 40px;
    }
  }
</style>

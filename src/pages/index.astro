---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { site, nbh } from '../site';
---

<Base>
  <section class="intro">
    <Portrait width={128} height={160} mobileWidth={112} mobileHeight={140} />
    <p class="t-lead bio">
      <span class="first">{site.name} — {site.role}.</span>
      <span class="muted">
        {nbh('Создаю и развиваю продукты, пишу на Python, Solidity, Swift и TypeScript, проектирую игры и уровни.')}
      </span>
    </p>
  </section>
  <ProjectGrid />
</Base>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
    padding: 112px 24px 0;
    text-align: center;
  }

  .bio {
    max-width: 640px;
  }

  .first {
    display: block;
  }

  @media (max-width: 640px) {
    .intro {
      gap: 28px;
      padding-top: 56px;
    }
  }
</style>
